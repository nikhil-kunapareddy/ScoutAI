# Copy to .env and fill in. Only the two Slack tokens are required — every other
# setting below shows its default and can be left commented out.

# Which agent this process runs (see scout/agents/): bigtech | university | resume
AGENT=bigtech

# ─── Slack (required) ─────────────────────────────────────────────────────
# Bot Token (starts with xoxb-) from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# App-Level Token (starts with xapp-) from Basic Information → App-Level Tokens.
# Needs the connections:write scope.
SLACK_APP_TOKEN=xapp-your-app-token-here

# ─── Anthropic Claude (hosted backend — the default when the key is set) ──
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
# Thinking depth / token spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# ─── Ollama (local backend — also the fallback when a hosted turn fails) ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ─── Meta Llama API (hosted backend) ──────────────────────────────────────
# Get a key at https://llama.developer.meta.com — only needed if you use --api.
LLAMA_API_KEY=
# Base URL of Meta's OpenAI-compatible endpoint (not the /chat/completions path).
LLAMA_BASE_URL=https://api.llama.com/compat/v1
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Backend a failed turn is replayed on
FALLBACK_BACKEND=ollama

# ─── Conversation limits ──────────────────────────────────────────────────
# MAX_TURNS=20        # user+assistant message pairs retained per user
# MAX_TOOL_HOPS=5     # tool-call round-trips allowed within a single message

# ─── Conversation state ───────────────────────────────────────────────────
# Where LangGraph checkpoints live. Empty keeps history in memory, so a restart
# is a clean slate — fine locally. Set a path (absolute, or relative to the
# project root) and history plus the parsed resume profile survive restarts,
# which is what the deployed bot uses.
# CHECKPOINT_DB=state/scout.sqlite

# ─── Daily digest ─────────────────────────────────────────────────────────
# Your Slack member id (profile → "Copy member ID"), not the bot's. Required
# only by `python -m scout.digest`.
# DIGEST_SLACK_USER=
# DIGEST_MAX_ROLES=5   # roles per agent, so the DM holds this many per section

# ─── Turn metrics ─────────────────────────────────────────────────────────
# Dollars per million tokens, used to price each turn in the `turn ...` log
# line. Left unset, the line reports tokens only. Fill from your provider's
# current pricing — the rates are not hard-coded because they change.
# USD_PER_MTOK_IN=
# USD_PER_MTOK_OUT=

# ─── LangSmith tracing (optional) ─────────────────────────────────────────
# Traces every graph node, model call, and tool call to smith.langchain.com.
# Needs no code: LangGraph instruments itself when these are set. Both the
# LANGSMITH_ and older LANGCHAIN_ prefixes work; LANGSMITH_ wins.
#
# NOTE: this sends prompts and completions off the box — including the résumé
# profile in the system prompt. Set the HIDE_ vars to keep the call tree,
# latency, and token counts while leaving the content behind.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=scout
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# ─── Logging ──────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR
# LOG_MAX_BYTES=5242880   # rotate logs/bot.log at 5 MB
# LOG_BACKUP_COUNT=3      # how many rotated files to keep

# ─── Timeouts (seconds) ───────────────────────────────────────────────────
# MODEL_REQUEST_TIMEOUT_SECONDS=300   # generation can be slow on local models
# TOOL_REQUEST_TIMEOUT_SECONDS=30     # job-search APIs / scraping
# GEO_REQUEST_TIMEOUT_SECONDS=10      # ip-api geolocation

# Note: each agent's system prompt and tool set are defined in its AgentSpec
# (scout/agents/), not here. Agents inherit the default backend chosen above.
