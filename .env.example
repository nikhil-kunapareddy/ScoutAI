# Which agent this process runs (see scout/agents/). Default: bigtech
AGENT=bigtech

# Slack Bot Token (starts with xoxb-) from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token (starts with xapp-) from Basic Information → App-Level Tokens
# Needs the connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token-here

# Ollama config (local backend)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Meta Llama API config (hosted backend)
# Get a key at https://llama.developer.meta.com — only needed if you use --api.
LLAMA_API_KEY=
LLAMA_API_URL=https://api.llama.com/v1/chat/completions
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Note: each agent's system prompt, tool set, and default backend are defined in
# its AgentSpec (scout/agents/), not here.
